#!/bin/sh
# Claude Code global settings.
#
# This is a chezmoi modify_ script rather than a plain tracked file because
# Claude Code and its ecosystem rewrite ~/.claude/settings.json at runtime, so a
# verbatim copy drifts constantly and every `chezmoi update` asks whether to
# overwrite it. The keys below are shared across machines; `hooks`,
# `enabledPlugins` and `autoMode` are machine-local (agent tooling and Claude
# Code itself stamp those in at runtime) and are carried over from whatever is
# already on disk.
set -e

managed=$(
	cat <<'JSON'
{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(* --version)",
      "Bash(* --help)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi status *)",
      "Bash(chezmoi apply --dry-run *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(git push * --force*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "env FORCE_COLOR=3 npx -y ccstatusline@latest",
    "padding": 0
  },
  "customInstructions": "Always test changes after implementing them.",
  "model": "opus[1m]",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  }
}
JSON
)

# Empty stdin means the file does not exist yet on this machine.
current=$(cat)
[ -n "$current" ] || current='{}'

if command -v jq >/dev/null 2>&1; then
	printf '%s\n' "$current" | jq --argjson managed "$managed" '
		$managed
		+ (if has("hooks") then {hooks} else {} end)
		+ (if has("enabledPlugins") then {enabledPlugins} else {} end)
		+ (if has("autoMode") then {autoMode} else {} end)
	'
	exit 0
fi

# chezmoi applies ~/.claude before .chezmoiscripts, so on a fresh machine jq is
# not installed yet. python3 ships on every platform we target, so use it to do
# the same merge instead of giving up.
if command -v python3 >/dev/null 2>&1; then
	MANAGED="$managed" CURRENT="$current" python3 -c '
import json, os, sys

managed = json.loads(os.environ["MANAGED"])
try:
    current = json.loads(os.environ["CURRENT"])
except ValueError:
    current = {}
if not isinstance(current, dict):
    current = {}
for key in ("hooks", "enabledPlugins", "autoMode"):
    if key in current:
        managed[key] = current[key]
json.dump(managed, sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
'
	exit 0
fi

# Neither merger is available. Pass the file through untouched, but say so on
# stderr: a silent passthrough leaves `chezmoi status` clean while none of the
# managed keys ever reach disk, which hides the failure completely.
printf '%s\n' "modify_settings.json: neither jq nor python3 found; ~/.claude/settings.json left unmanaged (model, effortLevel, permissions not applied). Install jq, then run: chezmoi apply ~/.claude/settings.json" >&2
if [ "$current" = '{}' ]; then
	printf '%s\n' "$managed"
else
	printf '%s\n' "$current"
fi
